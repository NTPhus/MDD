{
  "experiment": "asr-vietnamese-english-v1",
  "base_model": "models/pretrained/wav2vec2-base-960h",
  "corpus_root": "l2arctic_release_v5.0",
  "source_protocol": "data/protocol/l2arctic-plus-cascade-v1",
  "dataset_dir": "data/processed/asr-vietnamese-english-v1",
