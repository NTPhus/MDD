# Experimental local feedback backend; no LLM gateway or LLM API key is used.
# CLI: python scripts/llm_client.py --env-file configs/feedback_local.env.example --assessment contracts/examples/assessment.json
# For the web demo, put these LLM_* settings in .env and restart its Python server.
LLM_BACKEND=local
LLM_LOCAL_MODEL_PATH=models/pretrained/Qwen3-0.6B
LLM_LOCAL_ADAPTER_PATH=
# CPU inference leaves the RTX 3050 4GB available for MDD/QLoRA training.
LLM_LOCAL_DEVICE=cpu
LLM_LOCAL_THREADS=2
LLM_LOCAL_CONTEXT=4096
LLM_LOCAL_TIMEOUT_SEC=180
LLM_LOCAL_MAX_TOKENS=1024
# After training AND held-out quality review:
# LLM_LOCAL_ADAPTER_PATH=runs/feedback-qwen3-06b-v1/adapter
# Keep the existing AI33_* values in .env for TTS.
