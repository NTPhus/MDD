# Copy to .env and enter your key locally. Do not commit .env.
LLM_BACKEND=api
LLM_BASE_URL=https://llm.mrdnd.dev/v1
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SEC=240
LLM_MAX_TOKENS=8192

# Experimental Qwen3-0.6B local backend and QLoRA recipe:
# configs/feedback_local.env.example. Evaluate teaching quality before switching.
# Demo chat inference only: auto uses CUDA when enough memory is free at model
# load. Set cpu and restart demo before reserving all VRAM for another training.
MDD_CHAT_DEVICE=auto
# Preload local speech/Qwen models at demo startup; 0 keeps lazy loading.
MDD_CHAT_PREWARM=1
# Conversation recognition uses Whisper small.en; CUDA auto uses INT8/FP16.
# Set wav2vec2 explicitly only for a legacy comparison; restart after changing.
MDD_CHAT_ASR=whisper-small-en
# Device policies: auto prefers CUDA and records any CPU fallback at runtime.
# MDD_CHAT_DEVICE=cpu also defaults these to CPU unless explicitly overridden.
MDD_CHAT_ASR_DEVICE=auto
MDD_CHAT_PHONEME_DEVICE=auto
# CROTTC FP32 requires at least 2560 MiB free; 4 GB GPUs often keep it on CPU.
MDD_CHAT_CROTTC_DEVICE=auto
# Pronunciation: B remains default after the local paired evaluation.
# Choose CROTTC-IF explicitly in chat settings for an experimental comparison.
# These MDD settings are process environment overrides; code defaults also apply.
MDD_CHAT_PRONUNCIATION=wav2vec2-b

AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro

# Sarah - Mature, Reassuring, Confident (verified with ai33 --provider elevenlabs --search Sarah).
AI33_VOICE_EN=elevenlabs_EXAVITQu4vr4xnSDxMaL
AI33_VOICE_EN_NAME=Sarah - Mature, Reassuring, Confident
# Voice ID from the example supplied for this project; verify availability in your account.
AI33_VOICE_VI=edge_vi-VN-HoaiMyNeural
AI33_SPEED=1.0
AI33_TIMEOUT_SEC=120
AI33_POLL_INTERVAL_SEC=2

# HTTPS sharing. Keep the real token only in the ignored .env file.
NGROK_AUTHTOKEN=
# Optional assigned ngrok hostname, without scheme or path.
NGROK_DOMAIN=
