LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=1536

AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro

# Select an English voice from your account: --list-voices --provider edge --search en-US
AI33_VOICE_EN=
# Voice ID from the example supplied for this project; verify availability in your account.
AI33_VOICE_VI=edge_vi-VN-HoaiMyNeural
AI33_SPEED=1.0
AI33_TIMEOUT_SEC=120
AI33_POLL_INTERVAL_SEC=2
