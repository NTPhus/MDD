# Copy to .env and enter your key locally. Do not commit .env.
LLM_BACKEND=api
LLM_BASE_URL=https://llm.mrdnd.dev/v1
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SEC=240
LLM_MAX_TOKENS=8192

# Experimental Qwen3-0.6B local backend and QLoRA recipe:
# configs/feedback_local.env.example. Evaluate teaching quality before switching.

AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro

# Sarah - Mature, Reassuring, Confident (verified with ai33 --provider elevenlabs --search Sarah).
AI33_VOICE_EN=elevenlabs_EXAVITQu4vr4xnSDxMaL
AI33_VOICE_EN_NAME=Sarah - Mature, Reassuring, Confident
# Voice ID from the example supplied for this project; verify availability in your account.
AI33_VOICE_VI=edge_vi-VN-HoaiMyNeural
AI33_SPEED=1.0
AI33_TIMEOUT_SEC=120
AI33_POLL_INTERVAL_SEC=2

# HTTPS sharing. Keep the real token only in the ignored .env file.
NGROK_AUTHTOKEN=
# Optional assigned ngrok hostname, without scheme or path.
NGROK_DOMAIN=
